{
  "name": "@illli-studio/dsh-mory",
  "version": "0.1.2",
  "description": "Mory personal memory in the DeepSeek Harness sidebar, with shared agent tools.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/illli-studio/mory.git", "directory": "packages/dsh-mory" },
  "homepage": "https://github.com/illli-studio/mory/tree/main/packages/dsh-mory",
  "keywords": ["dsh", "cordis", "mory", "memory", "deepseek-harness"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18", "dsh": ">=0.2.1-rc.5 <0.3.0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "service.mjs", "settings.mjs", "protocol.mjs", "client.js", "src/client.js", "scripts/build-client.mjs", "assets", "test/*.mjs", "docs", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build-client.mjs && node --check index.js && node --check service.mjs && node --check settings.mjs && node --check protocol.mjs && node --check client.js",
    "typecheck": "npm run build",
    "lint": "npm run build",
    "test": "node --test test/*.mjs",
    "prepack": "npm run build && npm test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
