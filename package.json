{
  "name": "mory",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first personal memory repository.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mory/web dev",
    "api:dev": "pnpm --filter @mory/api dev",
    "api:start": "pnpm --filter @mory/api start",
    "build": "pnpm --filter @mory/memory-core build && pnpm --filter @illli-studio/mory-client-internal build && pnpm --filter @mory/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "node --test tests/*.mjs",
    "mory": "pnpm --filter @illli-studio/mory cli"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  }
}
